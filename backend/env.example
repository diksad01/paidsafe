PORT=5000

# Firebase Admin SDK — get these from Firebase Console > Project Settings > Service Accounts > Generate new private key
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=your-service-account-email@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# OpenRouter — get this from openrouter.ai > API Keys
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Flutterwave — get these from Flutterwave Dashboard > Settings > API Keys (Week 3)
FLUTTERWAVE_SECRET_KEY=FLWSECK-your-secret-key-here
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK-your-public-key-here
FLUTTERWAVE_WEBHOOK_SECRET=your-webhook-secret-here

# Resend — get this from resend.com > API Keys (Week 3)
RESEND_API_KEY=re_your-key-here

# Sentry — get this from sentry.io > Project Settings > DSN (Week 3)
SENTRY_DSN=https://your-key@sentry.io/your-project-id
